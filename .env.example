# Public origin only, without a path or trailing slash.
# Replace this preview domain with your verified production domain before launch.
# The .example fallback is intentionally noindex; changing this value requires a rebuild.
NEXT_PUBLIC_SITE_URL=https://divinestravels.example

# Gmail SMTP, matching the travel-addresses project.
# Use a Google App Password, not the account login password.
# Keep these server-side only; never prefix them with NEXT_PUBLIC_.
EMAIL_USER=
EMAIL_PASS=
# Inquiry recipient. Defaults to EMAIL_USER when blank.
EMAIL_TO=
